<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Model downloads and the worker protocol handshake need outbound network access. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- rfd::FileDialog save panels (export video, export diagnostics) grant
	     write access only to the file the user picks in the panel. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- The bundled PyInstaller worker embeds a Python interpreter and MLX/PyTorch,
	     which JIT-compile and load native extensions whose signatures do not match
	     the app's own Team ID. Same exceptions as the Developer ID build
	     (release.entitlements) — App Sandbox permits all three under review. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
</dict>
</plist>
