{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SynVid",
  "version": "0.2.0",
  "identifier": "com.synvid.desktop",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "AI-Video Synthesizer", "width": 1200, "height": 780, "resizable": true }],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Library/Application Support/SynVid/outputs/*/video.mp4",
          "$HOME/Library/Application Support/SynVid/outputs/*/image.png"
        ]
      }
    }
  },
  "bundle": { "active": true, "targets": ["dmg"], "icon": ["icons/SynVid.icns"], "resources": ["resources/worker"], "macOS": { "minimumSystemVersion": "14.0" } }
}
